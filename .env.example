# Copiar para .env é OPCIONAL: o docker-compose.yml já tem valores padrão
# de desenvolvimento para todas as variáveis abaixo.
# Troque os valores se for rodar fora do ambiente local.

DB_NAME=motores
DB_USER=motores
DB_PASSWORD=motores_dev
DB_ROOT_PASSWORD=root_dev

# Portas publicadas no host. Altere se alguma já estiver em uso na sua máquina.
API_PORT=3000
WEB_PORT=4200
DB_PORT=3306

# Padrão: http://localhost:${WEB_PORT}
# CORS_ORIGIN=http://localhost:4200
